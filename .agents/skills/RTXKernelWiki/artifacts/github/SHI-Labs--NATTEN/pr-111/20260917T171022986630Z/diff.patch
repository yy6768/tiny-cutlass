+  }
+
+  // Cmp
+  // CUTLASS_HOST_DEVICE bool operator<=(NA1dDim other) const {
+  //   return x <= other.x;
+  // }
+
+  // CUTLASS_HOST_DEVICE bool operator<(NA1dDim other) const {
