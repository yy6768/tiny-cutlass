+    return (int64_t)x;
+  }
+
+  CUTLASS_HOST_DEVICE int64_t prod() const {
+    return (int64_t)x;
+  }
+
+  CUTLASS_HOST_DEVICE int32_t prod32() const {
+    return x;
+  }
