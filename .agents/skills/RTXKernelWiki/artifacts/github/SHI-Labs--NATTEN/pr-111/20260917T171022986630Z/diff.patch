+struct NA3dDim {
+  int32_t x;
+  int32_t y;
+  int32_t z;
+
+  // Default ctor
+  CUTLASS_HOST_DEVICE constexpr NA3dDim(int32_t x_, int32_t y_, int32_t z_)
+      : x(x_), y(y_), z(z_) {}
+
