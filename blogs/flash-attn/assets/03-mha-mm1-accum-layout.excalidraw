    {
      "id": "1f5b3960a14d4eaaa",
      "type": "text",
      "x": 674,
      "y": 140,
      "width": 351.0,
      "height": 175.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
