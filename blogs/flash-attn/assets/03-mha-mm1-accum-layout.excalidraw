      "seed": 1231782307,
      "version": 1,
      "versionNonce": 955318834,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "accum_o is consumed directly by:\n\n1) MemoryEfficientAttentionNormalize\n   epilogue - rescale by s_prime[row]\n   (and out_rescale if not first tile),\n   OR\n\n2) the NEXT key-tile's iterative_softmax\n   rescale-in-place step, if kKeepOutputInRF\n   is true and this is not the last key tile.",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "accum_o is consumed directly by:\n\n1) MemoryEfficientAttentionNormalize\n   epilogue - rescale by s_prime[row]\n   (and out_rescale if not first tile),\n   OR\n\n2) the NEXT key-tile's iterative_softmax\n   rescale-in-place step, if kKeepOutputInRF\n   is true and this is not the last key tile.",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 10.66
    },
