    {
      "id": "a7c0266f94014b5e8",
      "type": "text",
      "x": 674,
      "y": 140,
      "width": 335.4,
      "height": 157.95000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1782330524,
      "version": 1,
      "versionNonce": 809751287,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "Each lane owns 8 elements total:\n2 rows {quad, quad+8} x 4 cols\n{lane_in_quad*2+col, 8+lane_in_quad*2+col}.\n\n4 lanes with the SAME quad (same\ncolor) own the SAME row-band but\nDIFFERENT columns - this is exactly\nthe group that must cooperate in the\nsoftmax row reduction (Diagram 2).",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each lane owns 8 elements total:\n2 rows {quad, quad+8} x 4 cols\n{lane_in_quad*2+col, 8+lane_in_quad*2+col}.\n\n4 lanes with the SAME quad (same\ncolor) own the SAME row-band but\nDIFFERENT columns - this is exactly\nthe group that must cooperate in the\nsoftmax row reduction (Diagram 2).",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 10.66
    },
    {
      "id": "cbead4cf47ec4215a",
      "type": "text",
      "x": 20,
      "y": 620,
      "width": 537.6,
      "height": 18.900000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1297722495,
      "version": 1,
      "versionNonce": 179414639,
      "index": null,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": null,
      "fontSize": 14,
      "fontFamily": 6,
      "text": "Legend: quad = lane_id>>2 (0-7)   lane_in_quad = lane_id&3 (0-3)",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Legend: quad = lane_id>>2 (0-7)   lane_in_quad = lane_id&3 (0-3)",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 11.479999999999999
    },
    {
      "id": "75b6a6e982eb46d2b",
