      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "roundness": null,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "Instantiation note: on SM89(Ada), DISPATCH_ARCHTAG treats CC>=80 as arch::Sm80, so this is the exact\naccumulator layout used (m16n8k8 f16 tensor-op MMA, same as A100).",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instantiation note: on SM89(Ada), DISPATCH_ARCHTAG treats CC>=80 as arch::Sm80, so this is the exact\naccumulator layout used (m16n8k8 f16 tensor-op MMA, same as A100).",
      "autoResize": true,
      "lineHeight": 1.25,
      "baseline": 10.66
    }
