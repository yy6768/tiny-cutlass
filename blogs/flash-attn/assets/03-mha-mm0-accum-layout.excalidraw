      "roundness": null,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "warpSize=32, one warp owns one 32x32 accumulator tile (WarpShape=32x32).",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "warpSize=32, one warp owns one 32x32 accumulator tile (WarpShape=32x32).",
