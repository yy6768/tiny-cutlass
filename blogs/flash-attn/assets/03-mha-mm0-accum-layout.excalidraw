      "roundness": null,
      "fontSize": 13,
      "fontFamily": 6,
      "text": "This excerpt shows rows 0-15, cols 0-15 (mma_m=0, mma_n in {0,1}) - pattern repeats for the rest of the 32x32 tile.",
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This excerpt shows rows 0-15, cols 0-15 (mma_m=0, mma_n in {0,1}) - pattern repeats for the rest of the 32x32 tile.",
